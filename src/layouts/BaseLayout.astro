---
import BaseHead from './components/BaseHead.astro';
import Header from './components/Header.astro';
import Footer from './components/Footer.astro';
import ThemeController from './components/ThemeController.astro';
import GlobalMusicPlayer from '../components/GlobalMusicPlayer.astro';
import { ClientRouter, fade } from 'astro:transitions';

const GTAG_MEASUREMENT_ID = import.meta.env.GTAG_MEASUREMENT_ID ?? '';
const { title, description, image, globalMusicTracks: passedGlobalMusicTracks = [] } = Astro.props;
const isHome = Astro.url.pathname === '/';
const globalMusicTracks = Array.isArray(passedGlobalMusicTracks) ? passedGlobalMusicTracks : [];
---

<!doctype html>
<html lang='en'>
	<head>
		<ThemeController />
		<BaseHead title={title} description={description} image={image} />
		<slot name='head' />
		<ClientRouter />
	</head>
	<body
		data-home={isHome ? 'true' : 'false'}
		class="pt-16 dark:text-zinc-100 sm:pt-0"
	>
		<Header/>
		<main class='min-h-[calc(100vh-160px)] py-8' transition:animate={fade({ duration: 160 })}>
			<slot />
		</main>
		<Footer />
		<GlobalMusicPlayer tracks={globalMusicTracks} />
		<script is:inline>
			const syncHomeFlag = () => {
				document.body.dataset.home = window.location.pathname === '/' ? 'true' : 'false';
			};

			if (document.readyState === 'loading') {
				document.addEventListener('DOMContentLoaded', syncHomeFlag, { once: true });
			} else {
				syncHomeFlag();
			}
			document.addEventListener('astro:page-load', syncHomeFlag);
		</script>
		<!-- Google tag (gtag.js) -->
    {
      GTAG_MEASUREMENT_ID &&
      <>
        <script is:inline type='text/partytown' async src={'https://www.googletagmanager.com/gtag/js?id=' + GTAG_MEASUREMENT_ID}></script>
        <script is:inline type='text/partytown' define:vars={{ GTAG_MEASUREMENT_ID }}>
          window.dataLayer = window.dataLayer || [];
          function gtag() {
            dataLayer.push(arguments);
          }
          gtag('js', new Date());

          gtag('config', GTAG_MEASUREMENT_ID);
        </script>
      </>
    }
	</body>
</html>

<style is:global>
	body {
		background-color: rgb(255 255 255);
	}

	body[data-home='false'] {
		background-image:
			linear-gradient(rgb(24 24 27 / 0.045) 1px, transparent 1px),
			linear-gradient(90deg, rgb(24 24 27 / 0.045) 1px, transparent 1px);
		background-size: 12px 12px;
		background-position: center top;
	}

	html.dark body {
		background-color: rgb(24 24 27);
		background-image: none;
	}

	html.dark body[data-home='false'] {
		background-image:
			linear-gradient(rgb(244 244 245 / 0.045) 1px, transparent 1px),
			linear-gradient(90deg, rgb(244 244 245 / 0.045) 1px, transparent 1px);
	}

	@media (min-width: 640px) {
		body {
			background-size: 12px 12px;
		}
	}
</style>
