---
import { Image } from 'astro:assets';
import GithubBlack from '@src/assets/img/github-mark.svg';
import XiaohongshuBlack from '@src/assets/img/xiaohongshu-mark-black.svg';
import { FOOTER_QUOTE, GITHUB_PROFILE_URL, SITE_TITLE, XIAOHONGSHU_PROFILE_URL } from '@src/consts';

const today = new Date();
const quoteParts = FOOTER_QUOTE.text.split(FOOTER_QUOTE.emphasis);

const navigation = [
	{ href: '/posts/', label: '文章' },
	{ href: '/fragments/', label: '随笔' },
	{ href: '/projects/', label: '捣鼓玩意' },
	{ href: '/photos/', label: '随手拍' },
	{ href: '/tags/', label: '标签' },
	{ href: '/about/', label: '关于我' }
];
---

<footer class='mt-16 border-t border-zinc-200 dark:border-zinc-800'>
	<div class='container grid gap-10 py-10 sm:grid-cols-[minmax(0,1.4fr)_1fr_1fr]'>
		<div>
			<h2 class='text-xs font-semibold text-zinc-500 dark:text-zinc-400'>关于 / About</h2>
			<a href='/' class='mt-3 inline-block text-xl font-bold text-zinc-950 no-underline dark:text-zinc-50'>{SITE_TITLE}</a>
			<blockquote class='mt-3 max-w-sm text-sm leading-6 text-zinc-600 dark:text-zinc-400'>
				<p class='whitespace-pre-line'>
					{
						quoteParts.map((part, index) => (
							<>
								{index > 0 && <strong class='font-semibold text-zinc-800 dark:text-zinc-200'>{FOOTER_QUOTE.emphasis}</strong>}
								{part}
							</>
						))
					}
				</p>
				<cite class='mt-2 block text-xs not-italic text-zinc-500 dark:text-zinc-500'>—— {FOOTER_QUOTE.source}</cite>
			</blockquote>
		</div>

		<nav aria-label='页脚导航'>
			<h2 class='text-xs font-semibold text-zinc-500 dark:text-zinc-400'>导航 / Navigation</h2>
			<ul class='mt-3 grid grid-cols-2 gap-x-4 gap-y-2 text-sm sm:grid-cols-1'>
				{
					navigation.map((item) => (
						<li>
							<a class='text-zinc-600 hover:text-zinc-950 dark:text-zinc-400 dark:hover:text-zinc-50' href={item.href}>
								「{item.label}」
							</a>
						</li>
					))
				}
			</ul>
		</nav>

		<div>
			<h2 class='text-xs font-semibold text-zinc-500 dark:text-zinc-400'>链接 / Elsewhere</h2>
			<div class='mt-3 flex items-center gap-1'>
				<a
					class='rounded-md p-2 transition hover:bg-zinc-100 dark:hover:bg-zinc-800'
					href={GITHUB_PROFILE_URL}
					target='_blank'
					rel='noopener noreferrer'
					aria-label='GitHub'
				>
					<Image src={GithubBlack} width={20} height={20} alt='' class='dark:invert' />
				</a>
				<a
					class='rounded-md p-2 transition hover:bg-zinc-100 dark:hover:bg-zinc-800'
					href={XIAOHONGSHU_PROFILE_URL}
					target='_blank'
					rel='noopener noreferrer'
					aria-label='小红书'
				>
					<Image src={XiaohongshuBlack} width={20} height={20} alt='' class='dark:invert' />
				</a>
			</div>
			<div class='mt-3 flex flex-col gap-2 text-sm'>
				<a class='text-zinc-600 hover:text-zinc-950 dark:text-zinc-400 dark:hover:text-zinc-50' href='/donate/'>请我喝杯绿茶</a>
				<a
					class='text-zinc-600 hover:text-zinc-950 dark:text-zinc-400 dark:hover:text-zinc-50'
					href='https://status.m0ne.top'
					target='_blank'
					rel='noopener noreferrer'>服务器状态</a
				>
			</div>
		</div>
	</div>

	<div class='border-t border-zinc-200 dark:border-zinc-800'>
		<div class='container flex flex-col gap-2 py-4 text-xs text-zinc-500 dark:text-zinc-400 sm:flex-row sm:items-center sm:justify-between'>
			<p>{SITE_TITLE} 的小天地 © {today.getFullYear()}</p>
			<p>
				模板来源 <a
					class='hover:text-zinc-950 dark:hover:text-zinc-50'
					href='https://devaradise.com'
					target='_blank'
					rel='nofollow noopener'>Syakir @ Devaradise</a
				>
			</p>
		</div>
	</div>
</footer>
