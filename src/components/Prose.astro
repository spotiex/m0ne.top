---

<div
	data-prose-root
	class='prose dark:prose-invert
  prose-h1:font-semibold prose-h1:my-4 prose-h1:text-2xl sm:prose-h1:text-[2rem]/[1.3]
  prose-h2:mt-6 prose-h2:mb-3 prose-h2:text-xl sm:prose-h2:text-3xl prose-h2:font-semibold
  prose-h3:mt-5 prose-h3:mb-2 prose-h3:text-lg sm:prose-h3:text-2xl prose-h3:font-semibold
  prose-h4:mt-3 prose-h4:mb-0 prose-h4:font-semibold prose-img:rounded-xl prose-h3:target:pt-20
  max-w-none break-words prose-p:leading-8 prose-li:leading-8'
>
	<slot />
</div>

<style>
	:global([data-prose-root]) {
		overflow-wrap: anywhere;
	}

	:global([data-prose-root] pre) {
		max-width: 100%;
		overflow-x: auto;
		-webkit-overflow-scrolling: touch;
	}

	:global([data-prose-root] table) {
		display: block;
		max-width: 100%;
		overflow-x: auto;
		-webkit-overflow-scrolling: touch;
	}

	:global([data-prose-root] img),
	:global([data-prose-root] video),
	:global([data-prose-root] iframe) {
		max-width: 100%;
	}

	:global([data-prose-root] :not(pre) > code) {
		border: 1px solid rgb(212 212 216);
		border-radius: 0.375rem;
		background: rgb(244 244 245);
		padding: 0.12rem 0.35rem;
		color: rgb(39 39 42);
		font-weight: 500;
		white-space: break-spaces;
	}

	:global([data-prose-root] :not(pre) > code::before),
	:global([data-prose-root] :not(pre) > code::after) {
		content: none;
	}

	:global(html.dark [data-prose-root] :not(pre) > code) {
		border-color: rgb(63 63 70);
		background: rgb(39 39 42);
		color: rgb(244 244 245);
	}
</style>
