---
interface Props {
	ariaLabel?: string;
}

const { ariaLabel = '图片预览' } = Astro.props as Props;
---

<div id='prose-lightbox' class='prose-lightbox' aria-hidden='true' hidden>
	<div class='prose-lightbox__backdrop' data-prose-lightbox-close></div>
	<div class='prose-lightbox__dialog' role='dialog' aria-modal='true' aria-label={ariaLabel}>
		<button type='button' class='prose-lightbox__close' data-prose-lightbox-close aria-label='关闭预览'>×</button>
		<figure class='prose-lightbox__figure'>
			<img id='prose-lightbox-image' src='' alt='' class='prose-lightbox__image' />
			<figcaption id='prose-lightbox-caption' class='prose-lightbox__caption'></figcaption>
		</figure>
	</div>
</div>

<script is:inline>
	const initProseLightbox = () => {
		const lightbox = document.getElementById('prose-lightbox');
		const image = document.getElementById('prose-lightbox-image');
		const caption = document.getElementById('prose-lightbox-caption');
		if (!lightbox || !image || !caption) return;
		if (lightbox.dataset.bound === '1') return;
		lightbox.dataset.bound = '1';

		const proseRoots = Array.from(document.querySelectorAll('[data-prose-root]'));
		const triggers = proseRoots
			.flatMap((root) =>
				Array.from(root.querySelectorAll('img')).filter(
					(element) => !element.closest('[data-no-lightbox]') && !element.closest('.photo-lightbox'),
				),
			);

		if (triggers.length === 0) return;

		triggers.forEach((trigger) => {
			trigger.classList.add('prose-zoomable');
			trigger.setAttribute('tabindex', '0');
			trigger.setAttribute('role', 'button');
			trigger.setAttribute('aria-label', `放大查看图片${trigger.getAttribute('alt') ? `：${trigger.getAttribute('alt')}` : ''}`);
		});

		let currentIndex = 0;
		const getCaption = (trigger) =>
			trigger.closest('figure')?.querySelector('figcaption')?.textContent?.trim() || trigger.getAttribute('alt') || '';

		const render = (index) => {
			if (triggers.length === 0) return;
			currentIndex = (index + triggers.length) % triggers.length;
			const trigger = triggers[currentIndex];
			image.setAttribute('src', trigger.getAttribute('src') || '');
			image.setAttribute('alt', trigger.getAttribute('alt') || '');
			caption.textContent = getCaption(trigger);
		};

		const open = (index) => {
			render(index);
			lightbox.hidden = false;
			lightbox.setAttribute('aria-hidden', 'false');
			document.body.classList.add('prose-lightbox-open');
		};

		const close = () => {
			lightbox.hidden = true;
			lightbox.setAttribute('aria-hidden', 'true');
			document.body.classList.remove('prose-lightbox-open');
			image.setAttribute('src', '');
		};

		const step = (delta) => {
			render(currentIndex + delta);
		};

		triggers.forEach((trigger, index) => {
			trigger.addEventListener('click', () => open(index));
			trigger.addEventListener('keydown', (event) => {
				if (event.key === 'Enter' || event.key === ' ') {
					event.preventDefault();
					open(index);
				}
			});
		});

		lightbox.querySelectorAll('[data-prose-lightbox-close]').forEach((element) => {
			element.addEventListener('click', close);
		});

		document.addEventListener('keydown', (event) => {
			if (lightbox.hidden) return;
			if (event.key === 'Escape') close();
			if (event.key === 'ArrowLeft') step(-1);
			if (event.key === 'ArrowRight') step(1);
		});

		document.addEventListener(
			'astro:before-swap',
			() => {
				close();
				lightbox.dataset.bound = '0';
			},
			{ once: true },
		);
	};

	if (document.readyState === 'loading') {
		document.addEventListener('DOMContentLoaded', initProseLightbox, { once: true });
	} else {
		initProseLightbox();
	}
	document.addEventListener('astro:page-load', initProseLightbox);
</script>

<style>
	:global([data-prose-root] img.prose-zoomable) {
		cursor: zoom-in;
	}

	.prose-lightbox {
		position: fixed;
		inset: 0;
		z-index: 1000;
	}

	.prose-lightbox__backdrop {
		position: absolute;
		inset: 0;
		background: rgba(15, 23, 42, 0.82);
		backdrop-filter: blur(6px);
	}

	.prose-lightbox__dialog {
		position: relative;
		z-index: 1;
		display: flex;
		min-height: 100%;
		align-items: center;
		justify-content: center;
		padding: 2rem 1.25rem;
	}

	.prose-lightbox__figure {
		margin: 0;
		max-width: min(92vw, 1120px);
		max-height: 92vh;
	}

	.prose-lightbox__image {
		display: block;
		max-width: 100%;
		max-height: calc(92vh - 4rem);
		border-radius: 1rem;
		object-fit: contain;
		box-shadow: 0 18px 80px rgba(15, 23, 42, 0.35);
	}

	.prose-lightbox__caption {
		margin-top: 0.9rem;
		text-align: center;
		color: rgb(228 228 231);
		font-size: 0.95rem;
		line-height: 1.7;
	}

	.prose-lightbox__close {
		position: absolute;
		top: 1rem;
		right: 1rem;
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: 2.75rem;
		height: 2.75rem;
		border: 0;
		border-radius: 999px;
		background: rgba(255, 255, 255, 0.14);
		color: white;
		font-size: 1.9rem;
		cursor: pointer;
	}

	:global(body.prose-lightbox-open) {
		overflow: hidden;
	}
</style>
