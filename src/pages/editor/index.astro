---
import '../../styles/global.css';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { SITE_TITLE } from '../../consts';
import { isAdminAuthenticated, isAdminConfigured } from '../../lib/server/adminAuth';
import { isGitHubPublishingConfigured } from '../../lib/server/githubContent';

export const prerender = false;

const isConfigured = isAdminConfigured();
const isAuthed = isAdminAuthenticated(Astro.cookies);
const canPublish = isGitHubPublishingConfigured();
---

<BaseLayout title={`移动写作 - ${SITE_TITLE}`} description='从手机撰写并发布博客文章与随笔'>
	<Fragment slot='head'>
		<meta name='robots' content='noindex,nofollow' />
		<meta name='theme-color' content='#18181b' />
		<link rel='manifest' href='/editor.webmanifest' />
		<link rel='apple-touch-icon' href='/editor-icon-192.png' />
	</Fragment>

	<div class='editor-shell mx-auto w-full max-w-5xl px-4 pb-24 sm:px-6'>
		<header class='mb-5 flex items-start justify-between gap-4'>
			<div>
				<p class='mb-1 text-xs font-semibold uppercase tracking-[0.18em] text-zinc-500 dark:text-zinc-400'>Private studio</p>
				<h1 class='m-0 text-2xl font-semibold text-zinc-950 dark:text-zinc-50'>移动写作</h1>
				<p class='mt-1 text-sm text-zinc-500 dark:text-zinc-400'>草稿留在设备上，确认发布后才会写入 Git。</p>
			</div>
			{
				isAuthed && (
					<button id='editor-logout' type='button' class='editor-button editor-button-secondary shrink-0'>
						退出
					</button>
				)
			}
		</header>

		{
			!isConfigured ? (
				<section class='editor-card border-amber-300 bg-amber-50 text-amber-950 dark:border-amber-800 dark:bg-amber-950/40 dark:text-amber-100'>
					<h2 class='mt-0 text-base font-semibold'>管理账号尚未配置</h2>
					<p class='mb-0 text-sm leading-6'>
						请配置 BLOG_ADMIN_USERNAME、BLOG_ADMIN_PASSWORD 和 BLOG_ADMIN_SESSION_SECRET；现有 PHOTO_ADMIN_* 配置也可以继续作为兼容回退。
					</p>
				</section>
			) : !isAuthed ? (
				<section class='editor-card mx-auto max-w-md'>
					<form id='editor-login-form' class='space-y-4'>
						<div>
							<h2 class='m-0 text-lg font-semibold'>登录写作后台</h2>
							<p class='mt-1 text-sm text-zinc-500 dark:text-zinc-400'>使用博客管理账号继续。</p>
						</div>
						<label class='editor-field'>
							<span>用户名</span>
							<input id='editor-login-username' type='text' autocomplete='username' required />
						</label>
						<label class='editor-field'>
							<span>密码</span>
							<input id='editor-login-password' type='password' autocomplete='current-password' required />
						</label>
						<p id='editor-login-status' class='min-h-5 text-sm text-zinc-500 dark:text-zinc-400' aria-live='polite' />
						<button type='submit' class='editor-button editor-button-primary w-full'>
							登录
						</button>
					</form>
				</section>
			) : (
				<div id='editor-app' data-can-publish={canPublish ? 'true' : 'false'}>
					{!canPublish && (
						<div class='mb-4 rounded-xl border border-amber-300 bg-amber-50 px-4 py-3 text-sm text-amber-950 dark:border-amber-800 dark:bg-amber-950/40 dark:text-amber-100'>
							当前可以浏览和试写；配置 BLOG_EDITOR_GITHUB_TOKEN 后才能正式发布。
						</div>
					)}

					<section class='editor-card mb-4'>
						<div class='grid gap-3 sm:grid-cols-[auto_minmax(0,1fr)_auto] sm:items-end'>
							<button id='editor-new' type='button' class='editor-button editor-button-primary'>
								新建内容
							</button>
							<label class='editor-field min-w-0'>
								<span>打开已发布内容</span>
								<select id='editor-existing'>
									<option value=''>正在读取内容列表…</option>
								</select>
							</label>
							<button id='editor-refresh' type='button' class='editor-button editor-button-secondary'>
								刷新
							</button>
						</div>
					</section>

					<form id='editor-form' class='space-y-4'>
						<section class='editor-card'>
							<div class='mb-4 flex items-center justify-between gap-3'>
								<div class='inline-flex rounded-xl bg-zinc-100 p-1 dark:bg-zinc-900' role='group' aria-label='内容类型'>
									<button type='button' class='editor-type-button is-active' data-editor-type='blog'>
										长文
									</button>
									<button type='button' class='editor-type-button' data-editor-type='fragment'>
										随笔
									</button>
								</div>
								<span id='editor-save-state' class='text-xs text-zinc-500 dark:text-zinc-400' aria-live='polite'>
									准备就绪
								</span>
							</div>

							<div class='grid gap-4 sm:grid-cols-2'>
								<label class='editor-field sm:col-span-2'>
									<span>标题</span>
									<input id='editor-title' name='title' type='text' maxlength='200' placeholder='给这段文字一个名字' required />
								</label>
								<label class='editor-field'>
									<span>发布日期</span>
									<input id='editor-pub-date' name='pubDate' type='date' required />
								</label>
								<label class='editor-field'>
									<span>Slug</span>
									<input id='editor-slug' name='slug' type='text' inputmode='url' pattern='[a-z0-9]+(?:-[a-z0-9]+)*' required />
								</label>
								<label class='editor-field sm:col-span-2'>
									<span>摘要</span>
									<textarea
										id='editor-description'
										name='description'
										rows='2'
										maxlength='500'
										placeholder='列表和分享卡片上会看到这句话'
									/>
								</label>
								<label class='editor-field sm:col-span-2'>
									<span>
										标签 <small>用逗号分隔</small>
									</span>
									<input id='editor-tags' name='tags' type='text' placeholder='博客, 生活' />
								</label>
							</div>

							<details class='mt-4 rounded-xl border border-zinc-200 dark:border-zinc-800'>
								<summary class='cursor-pointer px-4 py-3 text-sm font-medium'>更多信息</summary>
								<div class='grid gap-4 border-t border-zinc-200 p-4 dark:border-zinc-800 sm:grid-cols-2'>
									<label class='editor-field' data-blog-field>
										<span>SEO 标题</span>
										<input id='editor-seo-title' type='text' />
									</label>
									<label class='editor-field' data-blog-field>
										<span>封面地址</span>
										<input id='editor-cover-image' type='text' placeholder='https://… 或 ./cover.jpg' />
									</label>
									<label class='editor-field' data-blog-field>
										<span>更新日期</span>
										<input id='editor-updated-date' type='date' />
									</label>
									<label class='editor-field hidden' data-fragment-field>
										<span>地点</span>
										<input id='editor-location' type='text' placeholder='北京 海淀' />
									</label>
									<label class='editor-field hidden' data-fragment-field>
										<span>天气</span>
										<input id='editor-weather' type='text' placeholder='晴' />
									</label>
								</div>
							</details>
						</section>

						<section class='editor-card overflow-hidden p-0'>
							<div class='flex items-center justify-between border-b border-zinc-200 px-3 py-2 dark:border-zinc-800'>
								<div class='inline-flex gap-1'>
									<button type='button' class='editor-tab is-active' data-editor-tab='write'>
										编辑
									</button>
									<button type='button' class='editor-tab' data-editor-tab='preview'>
										预览
									</button>
								</div>
								<div class='flex gap-1' aria-label='Markdown 快捷输入'>
									<button type='button' class='editor-tool' data-editor-wrap='**' title='粗体'>
										B
									</button>
									<button type='button' class='editor-tool italic' data-editor-wrap='*' title='斜体'>
										I
									</button>
									<button type='button' class='editor-tool' data-editor-prefix='## ' title='二级标题'>
										H2
									</button>
									<button type='button' class='editor-tool' data-editor-prefix='- ' title='列表'>
										•
									</button>
									<button
									id='editor-media-open'
									type='button'
									class='editor-tool gap-1 px-2'
										title='插入或编辑图片'
										aria-label='插入或编辑图片'
										disabled
									>
									<span aria-hidden='true'>▧</span><span>图片</span>
									</button>
								</div>
							</div>
							<div id='editor-write-panel'>
								<label class='sr-only' for='editor-body'>
									Markdown 正文
								</label>
								<textarea id='editor-body' name='body' class='editor-body' placeholder='从这里开始写…' required />
							</div>
							<div id='editor-preview-panel' class='hidden min-h-[50vh] p-5 sm:p-8'>
								<h1 id='editor-preview-title' class='mb-5 text-3xl font-semibold text-zinc-950 dark:text-zinc-50'>
									无标题
								</h1>
								<iframe
									id='editor-preview'
									title='Markdown 预览'
									sandbox=''
									class='min-h-[55vh] w-full rounded-xl border-0 bg-white dark:bg-zinc-950'
								/>
							</div>
						</section>

						<div class='editor-publish-bar'>
							<div class='min-w-0'>
								<p id='editor-status' class='m-0 truncate text-sm text-zinc-600 dark:text-zinc-300' aria-live='polite'>
									尚未发布
								</p>
							</div>
							<button id='editor-publish' type='submit' class='editor-button editor-button-primary shrink-0' disabled={!canPublish}>
								检查并发布
							</button>
						</div>
					</form>

					<dialog id='editor-publish-dialog' class='editor-dialog'>
						<form method='dialog' class='space-y-4'>
							<div>
								<p class='mb-1 text-xs font-semibold uppercase tracking-[0.15em] text-zinc-500'>Publish</p>
								<h2 class='m-0 text-xl font-semibold'>确认发布</h2>
							</div>
							<div id='editor-publish-summary' class='rounded-xl bg-zinc-100 p-4 text-sm leading-6 dark:bg-zinc-900' />
							<p class='text-sm text-zinc-500 dark:text-zinc-400'>发布将向 GitHub 提交文件，并触发站点重新部署。</p>
							<div class='flex justify-end gap-2'>
								<button value='cancel' class='editor-button editor-button-secondary'>
									返回修改
								</button>
								<button id='editor-confirm-publish' value='default' class='editor-button editor-button-primary'>
									确认发布
								</button>
							</div>
						</form>
					</dialog>

					<dialog id='editor-media-dialog' class='editor-media-dialog'>
						<div class='editor-media-panel'>
							<header class='flex items-start justify-between gap-4 border-b border-zinc-200 p-4 dark:border-zinc-800 sm:p-5'>
								<div>
									<p class='mb-1 text-xs font-semibold uppercase tracking-[0.15em] text-zinc-500'>Media block</p>
									<h2 id='editor-media-title' class='m-0 text-xl font-semibold'>
										插入图片
									</h2>
								</div>
								<button id='editor-media-close' type='button' class='editor-button editor-button-secondary px-3' aria-label='关闭图片面板'>
									×
								</button>
							</header>

							<div class='editor-media-content'>
								<section>
									<div id='editor-media-dropzone' class='editor-media-dropzone' tabindex='0' role='button'>
										<input id='editor-media-files' type='file' accept='image/*' multiple class='sr-only' />
										<strong>选择、拍摄或拖入图片</strong>
										<span>JPEG、PNG、WebP、GIF；单张不超过 30 MB</span>
									</div>
									<div class='mt-3 flex gap-2'>
										<input id='editor-media-url' type='url' class='editor-media-input min-w-0 grow' placeholder='也可以粘贴已有图片 URL' />
										<button id='editor-media-add-url' type='button' class='editor-button editor-button-secondary shrink-0'>
											添加 URL
										</button>
									</div>
								</section>

								<div id='editor-media-list' class='space-y-3' />

								<section class='grid gap-4 rounded-xl border border-zinc-200 p-4 dark:border-zinc-800 sm:grid-cols-2 lg:grid-cols-4'>
									<label class='editor-field'>
										<span>列数</span>
										<select id='editor-media-columns'>
											<option value='auto'>自动</option>
											<option value='1'>1 列</option>
											<option value='2'>2 列</option>
											<option value='3'>3 列</option>
										</select>
									</label>
									<label class='editor-field'>
										<span>比例</span>
										<select id='editor-media-ratio'>
											<option value='original'>原始</option>
											<option value='landscape'>横向 4:3</option>
											<option value='portrait'>纵向 3:4</option>
											<option value='square'>方形 1:1</option>
										</select>
									</label>
									<label class='editor-field'>
										<span>适应方式</span>
										<select id='editor-media-fit'>
											<option value='cover'>裁切填满</option>
											<option value='contain'>完整显示</option>
										</select>
									</label>
									<label class='editor-field'>
										<span>宽度</span>
										<select id='editor-media-width'>
											<option value='compact'>紧凑</option>
											<option value='normal'>正文</option>
											<option value='wide'>宽幅</option>
										</select>
									</label>
									<label class='editor-field sm:col-span-2 lg:col-span-4'>
										<span>整组图注</span>
										<input id='editor-media-caption' type='text' placeholder='可选' />
									</label>
									<label class='flex items-start gap-3 text-sm sm:col-span-2 lg:col-span-4'>
										<input id='editor-media-original' type='checkbox' class='mt-1 size-4' />
										<span>
											<strong class='block'>上传原图</strong>
											<small class='text-zinc-500 dark:text-zinc-400'>
												默认会压缩到最长边 2560px 并清除元数据；原图可能更大且保留 EXIF。
											</small>
										</span>
									</label>
								</section>
								<p id='editor-media-status' class='min-h-5 text-sm text-zinc-500 dark:text-zinc-400' aria-live='polite' />
							</div>

							<footer class='flex justify-end gap-2 border-t border-zinc-200 p-4 dark:border-zinc-800 sm:p-5'>
								<button id='editor-media-cancel' type='button' class='editor-button editor-button-secondary'>
									取消
								</button>
								<button id='editor-media-insert' type='button' class='editor-button editor-button-primary'>
									上传并插入
								</button>
							</footer>
						</div>
					</dialog>
				</div>
			)
		}
	</div>
</BaseLayout>

<style>
	.editor-card {
		@apply rounded-2xl border border-zinc-200 bg-white p-4 shadow-sm dark:border-zinc-800 dark:bg-zinc-950 sm:p-5;
	}
	.editor-button {
		@apply inline-flex min-h-10 items-center justify-center rounded-xl px-4 py-2 text-sm font-medium transition disabled:cursor-not-allowed disabled:opacity-50;
	}
	.editor-button-primary {
		@apply bg-zinc-950 text-white hover:bg-zinc-700 dark:bg-zinc-100 dark:text-zinc-950 dark:hover:bg-zinc-300;
	}
	.editor-button-secondary {
		@apply border border-zinc-300 bg-white text-zinc-800 hover:bg-zinc-100 dark:border-zinc-700 dark:bg-zinc-950 dark:text-zinc-100 dark:hover:bg-zinc-900;
	}
	.editor-field {
		@apply block text-sm;
	}
	.editor-field > span {
		@apply mb-1.5 block text-xs font-medium text-zinc-600 dark:text-zinc-400;
	}
	.editor-field small {
		@apply font-normal text-zinc-400;
	}
	.editor-field :global(input),
	.editor-field :global(textarea),
	.editor-field :global(select) {
		@apply w-full rounded-xl border border-zinc-300 bg-white px-3 py-2.5 text-base text-zinc-950 outline-none transition focus:border-zinc-600 focus:ring-2 focus:ring-zinc-200 dark:border-zinc-700 dark:bg-zinc-950 dark:text-zinc-50 dark:focus:border-zinc-400 dark:focus:ring-zinc-800;
	}
	.editor-type-button,
	.editor-tab {
		@apply rounded-lg px-3 py-2 text-sm text-zinc-500 transition dark:text-zinc-400;
	}
	.editor-type-button.is-active,
	.editor-tab.is-active {
		@apply bg-white font-medium text-zinc-950 shadow-sm dark:bg-zinc-800 dark:text-zinc-50;
	}
	.editor-type-button:disabled {
		@apply cursor-not-allowed opacity-50;
	}
	.editor-tool {
		@apply flex h-9 min-w-9 items-center justify-center rounded-lg text-xs font-semibold text-zinc-600 hover:bg-zinc-100 dark:text-zinc-300 dark:hover:bg-zinc-900;
	}
	.editor-body {
		@apply block min-h-[52vh] w-full resize-y border-0 bg-transparent p-4 font-mono text-base leading-7 text-zinc-950 outline-none dark:text-zinc-50 sm:min-h-[60vh] sm:p-6;
	}
	.editor-publish-bar {
		@apply fixed inset-x-3 bottom-3 z-40 mx-auto flex max-w-3xl items-center justify-between gap-3 rounded-2xl border border-zinc-200 bg-white/95 p-3 shadow-xl backdrop-blur dark:border-zinc-700 dark:bg-zinc-950/95;
		padding-bottom: max(0.75rem, env(safe-area-inset-bottom));
	}
	.editor-dialog {
		@apply m-auto w-[calc(100%-2rem)] max-w-md rounded-2xl border border-zinc-200 bg-white p-5 text-zinc-950 shadow-2xl backdrop:bg-zinc-950/60 dark:border-zinc-700 dark:bg-zinc-950 dark:text-zinc-50;
	}
	.editor-dialog[open] {
		animation: editor-dialog-in 140ms ease-out;
	}
	.editor-media-dialog {
		@apply m-auto h-[min(92dvh,900px)] w-[calc(100%-1rem)] max-w-5xl overflow-hidden rounded-2xl border border-zinc-200 bg-white p-0 text-zinc-950 shadow-2xl backdrop:bg-zinc-950/60 dark:border-zinc-700 dark:bg-zinc-950 dark:text-zinc-50;
	}
	.editor-media-panel {
		@apply flex h-full flex-col;
	}
	.editor-media-content {
		@apply min-h-0 grow space-y-4 overflow-y-auto p-4 sm:p-5;
	}
	.editor-media-dropzone {
		@apply flex min-h-28 cursor-pointer flex-col items-center justify-center gap-1 rounded-xl border-2 border-dashed border-zinc-300 bg-zinc-50 px-4 text-center outline-none transition hover:border-zinc-500 focus:border-zinc-600 focus:ring-2 focus:ring-zinc-200 dark:border-zinc-700 dark:bg-zinc-900/60 dark:hover:border-zinc-500 dark:focus:ring-zinc-800;
	}
	.editor-media-dropzone span {
		@apply text-xs text-zinc-500 dark:text-zinc-400;
	}
	.editor-media-input {
		@apply rounded-xl border border-zinc-300 bg-white px-3 py-2.5 text-base outline-none focus:border-zinc-600 focus:ring-2 focus:ring-zinc-200 dark:border-zinc-700 dark:bg-zinc-950 dark:focus:ring-zinc-800;
	}
	:global(.editor-media-card-field) {
		@apply block text-sm;
	}
	:global(.editor-media-card-field > span) {
		@apply mb-1 block text-xs font-medium text-zinc-600 dark:text-zinc-400;
	}
	:global(.editor-media-card-field > input) {
		@apply w-full rounded-lg border border-zinc-300 bg-white px-3 py-2 text-sm outline-none focus:border-zinc-600 dark:border-zinc-700 dark:bg-zinc-950;
	}
	@media (max-width: 639px) {
		.editor-media-dialog {
			@apply mb-0 h-[94dvh] w-full max-w-none rounded-b-none rounded-t-2xl;
		}
	}
	@keyframes editor-dialog-in {
		from {
			opacity: 0;
			transform: translateY(8px) scale(0.98);
		}
	}
</style>

<script>
	import { processEditorImage } from '../../lib/client/editorImageProcessing';
	import { findEditorMediaBlock, serializeEditorMediaBlock } from '../../lib/editorMedia';

	window.dispatchEvent(
		new CustomEvent('m0ne-editor-media-ready', {
			detail: { findEditorMediaBlock, serializeEditorMediaBlock, processEditorImage }
		})
	);
</script>

<script is:inline>
	let mediaTools = null;
	window.addEventListener('m0ne-editor-media-ready', (event) => {
		mediaTools = event.detail;
		const openButton = document.getElementById('editor-media-open');
		if (openButton instanceof HTMLButtonElement) openButton.disabled = false;
	});

	const setupEditorPage = () => {
		const loginForm = document.querySelector('#editor-login-form');
		if (loginForm instanceof HTMLFormElement && loginForm.dataset.ready !== 'true') {
			loginForm.dataset.ready = 'true';
			loginForm.addEventListener('submit', async (event) => {
				event.preventDefault();
				const status = document.querySelector('#editor-login-status');
				const button = loginForm.querySelector('button[type="submit"]');
				const username = document.querySelector('#editor-login-username');
				const password = document.querySelector('#editor-login-password');
				if (!(username instanceof HTMLInputElement) || !(password instanceof HTMLInputElement)) return;
				if (button instanceof HTMLButtonElement) button.disabled = true;
				if (status instanceof HTMLElement) status.textContent = '正在登录…';
				try {
					const response = await fetch('/api/editor/login.json', {
						method: 'POST',
						headers: { 'content-type': 'application/json' },
						body: JSON.stringify({ username: username.value, password: password.value })
					});
					const result = await response.json();
					if (!response.ok) throw new Error(result.error || '登录失败');
					window.location.reload();
				} catch (error) {
					if (status instanceof HTMLElement) status.textContent = error instanceof Error ? error.message : '登录失败';
					if (button instanceof HTMLButtonElement) button.disabled = false;
				}
			});
		}

		const app = document.querySelector('#editor-app');
		if (!(app instanceof HTMLElement) || app.dataset.ready === 'true') return;
		app.dataset.ready = 'true';

		const byId = (id) => document.getElementById(id);
		const form = byId('editor-form');
		const bodyInput = byId('editor-body');
		const typeButtons = [...document.querySelectorAll('[data-editor-type]')];
		const existingSelect = byId('editor-existing');
		const dialog = byId('editor-publish-dialog');
		const confirmPublish = byId('editor-confirm-publish');
		const publishButton = byId('editor-publish');
		const mediaDialog = byId('editor-media-dialog');
		const mediaList = byId('editor-media-list');
		const mediaFileInput = byId('editor-media-files');
		const mediaInsertButton = byId('editor-media-insert');
		const storageKey = 'm0ne.editor.draft.v1';
		let activeType = 'blog';
		let activePath = '';
		let activeSha = '';
		let publishPayload = null;
		let publishing = false;
		let hasUnpublishedChanges = false;
		let autosaveTimer = 0;
		let previewRequestId = 0;
		let mediaItems = [];
		let mediaReplaceRange = null;
		let mediaBusy = false;
		let previewStylesPromise = null;

		const getInput = (id) => {
			const node = byId(id);
			return node instanceof HTMLInputElement || node instanceof HTMLTextAreaElement ? node : null;
		};
		const today = () => {
			const date = new Date();
			const year = date.getFullYear();
			const month = String(date.getMonth() + 1).padStart(2, '0');
			const day = String(date.getDate()).padStart(2, '0');
			return `${year}-${month}-${day}`;
		};
		const defaultSlug = (type = activeType) => `${today()}-${type === 'blog' ? 'post' : 'fragment'}`;
		const setStatus = (message, tone = '') => {
			const node = byId('editor-status');
			if (!(node instanceof HTMLElement)) return;
			node.textContent = message;
			node.classList.toggle('text-red-600', tone === 'error');
			node.classList.toggle('dark:text-red-400', tone === 'error');
			if (!tone) node.classList.add('text-zinc-600', 'dark:text-zinc-300');
		};
		const setSaveState = (message) => {
			const node = byId('editor-save-state');
			if (node instanceof HTMLElement) node.textContent = message;
		};

		const collect = () => ({
			type: activeType,
			path: activePath,
			sha: activeSha,
			slug: getInput('editor-slug')?.value.trim() || '',
			title: getInput('editor-title')?.value.trim() || '',
			seoTitle: getInput('editor-seo-title')?.value.trim() || '',
			description: getInput('editor-description')?.value.trim() || '',
			pubDate: getInput('editor-pub-date')?.value || '',
			updatedDate: getInput('editor-updated-date')?.value || '',
			tags: (getInput('editor-tags')?.value || '')
				.split(/[,，]/)
				.map((tag) => tag.trim())
				.filter(Boolean),
			coverImage: getInput('editor-cover-image')?.value.trim() || '',
			location: getInput('editor-location')?.value.trim() || '',
			weather: getInput('editor-weather')?.value.trim() || '',
			body: getInput('editor-body')?.value || ''
		});

		const applyType = (type) => {
			activeType = type === 'fragment' ? 'fragment' : 'blog';
			typeButtons.forEach((button) => button.classList.toggle('is-active', button.getAttribute('data-editor-type') === activeType));
			document.querySelectorAll('[data-blog-field]').forEach((node) => node.classList.toggle('hidden', activeType !== 'blog'));
			document.querySelectorAll('[data-fragment-field]').forEach((node) => node.classList.toggle('hidden', activeType !== 'fragment'));
		};

		const applyDocument = (document) => {
			activePath = document.path || '';
			activeSha = document.sha || '';
			applyType(document.type);
			typeButtons.forEach((button) => {
				if (button instanceof HTMLButtonElement) button.disabled = Boolean(activePath);
			});
			const slugInput = getInput('editor-slug');
			if (slugInput instanceof HTMLInputElement) slugInput.readOnly = Boolean(activePath && document.type === 'fragment');
			const values = {
				'editor-slug': document.slug,
				'editor-title': document.title,
				'editor-seo-title': document.seoTitle,
				'editor-description': document.description,
				'editor-pub-date': document.pubDate,
				'editor-updated-date': document.updatedDate,
				'editor-tags': (document.tags || []).join(', '),
				'editor-cover-image': document.coverImage,
				'editor-location': document.location,
				'editor-weather': document.weather,
				'editor-body': document.body
			};
			Object.entries(values).forEach(([id, value]) => {
				const input = getInput(id);
				if (input) input.value = value || '';
			});
		};

		const newDocument = (type = activeType) => {
			applyDocument({
				type,
				path: '',
				sha: '',
				slug: defaultSlug(type),
				title: '',
				seoTitle: '',
				description: '',
				pubDate: today(),
				updatedDate: '',
				tags: type === 'blog' ? ['博客'] : [],
				coverImage: '',
				location: '',
				weather: '',
				body: ''
			});
			if (existingSelect instanceof HTMLSelectElement) existingSelect.value = '';
			setStatus('已新建本地草稿');
			hasUnpublishedChanges = false;
			getInput('editor-title')?.focus();
			saveDraft();
		};

		const saveDraft = () => {
			try {
				localStorage.setItem(storageKey, JSON.stringify({ version: 1, savedAt: new Date().toISOString(), document: collect() }));
				setSaveState(`已保存 ${new Date().toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' })}`);
			} catch {
				setSaveState('本地保存失败');
			}
		};
		const scheduleDraft = () => {
			setSaveState('正在保存…');
			window.clearTimeout(autosaveTimer);
			autosaveTimer = window.setTimeout(saveDraft, 350);
		};

		const restoreDraft = () => {
			try {
				const draft = JSON.parse(localStorage.getItem(storageKey) || 'null');
				if (draft?.version === 1 && draft.document) {
					applyDocument(draft.document);
					setStatus('已恢复这台设备上的草稿');
					setSaveState('草稿已恢复');
					hasUnpublishedChanges = true;
					return;
				}
			} catch {
				localStorage.removeItem(storageKey);
			}
			newDocument('blog');
		};

		const loadList = async () => {
			if (!(existingSelect instanceof HTMLSelectElement)) return;
			existingSelect.disabled = true;
			existingSelect.innerHTML = '<option value="">正在读取内容列表…</option>';
			try {
				const response = await fetch('/api/editor/content/index.json');
				const result = await response.json();
				if (!response.ok) throw new Error(result.error || '读取失败');
				existingSelect.innerHTML = '<option value="">选择一篇内容…</option>';
				for (const item of result.items || []) {
					const option = document.createElement('option');
					option.value = item.path;
					option.textContent = `${item.type === 'blog' ? '长文' : '随笔'} · ${item.pubDate || '无日期'} · ${item.title || item.slug}`;
					existingSelect.append(option);
				}
				if (activePath) existingSelect.value = activePath;
			} catch (error) {
				existingSelect.innerHTML = '<option value="">内容列表读取失败</option>';
				setStatus(error instanceof Error ? error.message : '内容列表读取失败', 'error');
			} finally {
				existingSelect.disabled = false;
			}
		};

		const loadDocument = async (path) => {
			if (!path) return;
			if (hasUnpublishedChanges && !window.confirm('当前编辑内容已经保存在本机草稿中。仍要打开另一篇内容并替换编辑区吗？')) {
				if (existingSelect instanceof HTMLSelectElement) existingSelect.value = activePath;
				return;
			}
			setStatus('正在打开内容…');
			try {
				const response = await fetch(`/api/editor/content/item.json?path=${encodeURIComponent(path)}`);
				const result = await response.json();
				if (!response.ok) throw new Error(result.error || '读取失败');
				applyDocument(result.document);
				saveDraft();
				hasUnpublishedChanges = false;
				setStatus(
					result.warning
						? `已打开本地「${result.document.title || result.document.slug}」；GitHub 匿名额度已耗尽，当前不能更新发布`
						: `已打开「${result.document.title || result.document.slug}」`
				);
			} catch (error) {
				setStatus(error instanceof Error ? error.message : '内容读取失败', 'error');
			}
		};

		const renderPreview = async () => {
			const requestId = ++previewRequestId;
			const preview = byId('editor-preview');
			const previewTitle = byId('editor-preview-title');
			if (previewTitle instanceof HTMLElement) previewTitle.textContent = getInput('editor-title')?.value || '无标题';
			if (!(preview instanceof HTMLIFrameElement)) return;
			preview.srcdoc = '<p style="font:14px system-ui;color:#71717a">正在使用 Astro 渲染预览…</p>';

			try {
				previewStylesPromise ??= fetch('/editor-preview.css').then(async (response) => {
					if (!response.ok) throw new Error('预览样式加载失败');
					return response.text();
				});
				const [response, previewStyles] = await Promise.all([
					fetch('/api/editor/preview.json', {
						method: 'POST',
						headers: { 'content-type': 'application/json' },
						body: JSON.stringify({ body: getInput('editor-body')?.value || '' })
					}),
					previewStylesPromise
				]);
				const result = await response.json();
				if (!response.ok) throw new Error(result.error || '预览渲染失败');
				if (requestId !== previewRequestId) return;
				const safeStyles = previewStyles.replace(/<\/style/gi, '<\\/style');
				preview.srcdoc = `<!doctype html><html lang="zh-CN"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><style>${safeStyles}</style></head><body><main>${result.html}</main></body></html>`;
			} catch (error) {
				if (requestId !== previewRequestId) return;
				const message = error instanceof Error ? error.message : '预览渲染失败';
				preview.srcdoc = `<p style="font:14px system-ui;color:#dc2626">${message.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;')}</p>`;
			}
		};

		const formatBytes = (bytes) => {
			if (!Number.isFinite(bytes) || bytes <= 0) return '—';
			if (bytes < 1024 * 1024) return `${Math.max(1, Math.round(bytes / 1024))} KB`;
			return `${(bytes / 1024 / 1024).toFixed(1)} MB`;
		};
		const setMediaStatus = (message, isError = false) => {
			const node = byId('editor-media-status');
			if (!(node instanceof HTMLElement)) return;
			node.textContent = message;
			node.classList.toggle('text-red-600', isError);
			node.classList.toggle('dark:text-red-400', isError);
		};
		const releaseMediaPreviews = () => {
			for (const item of mediaItems) {
				if (item.localPreview) URL.revokeObjectURL(item.localPreview);
			}
		};
		const getMediaSelectValue = (id, fallback) => {
			const node = byId(id);
			return node instanceof HTMLSelectElement ? node.value : fallback;
		};
		const setMediaValue = (id, value) => {
			const node = byId(id);
			if (node instanceof HTMLInputElement || node instanceof HTMLSelectElement) node.value = value;
		};

		const renderMediaItems = () => {
			if (!(mediaList instanceof HTMLElement)) return;
			mediaList.replaceChildren();
			mediaItems.forEach((item, index) => {
				const card = document.createElement('article');
				card.className = 'grid gap-3 rounded-xl border border-zinc-200 p-3 dark:border-zinc-800 sm:grid-cols-[120px_minmax(0,1fr)_auto]';
				card.innerHTML = `
					<img class="h-28 w-full rounded-lg bg-zinc-100 object-cover sm:h-24" alt="">
					<div class="grid min-w-0 gap-2 sm:grid-cols-2">
						<label class="editor-media-card-field sm:col-span-2"><span>Alt 文本</span><input data-media-alt type="text" placeholder="描述图片内容"></label>
						<label class="editor-media-card-field sm:col-span-2"><span>图片图注</span><input data-media-caption type="text" placeholder="可选"></label>
						<label class="flex items-center gap-2 text-xs text-zinc-500"><input data-media-decorative type="checkbox"> 装饰图（Alt 留空）</label>
						<p data-media-size class="m-0 text-xs text-zinc-500 sm:text-right"></p>
					</div>
					<div class="flex gap-1 sm:flex-col">
						<button data-media-up type="button" class="flex h-9 min-w-9 items-center justify-center rounded-lg text-sm hover:bg-zinc-100 dark:hover:bg-zinc-900" aria-label="向前移动">↑</button>
						<button data-media-down type="button" class="flex h-9 min-w-9 items-center justify-center rounded-lg text-sm hover:bg-zinc-100 dark:hover:bg-zinc-900" aria-label="向后移动">↓</button>
						<button data-media-remove type="button" class="flex h-9 min-w-9 items-center justify-center rounded-lg text-sm text-red-600 hover:bg-red-50 dark:text-red-400 dark:hover:bg-red-950/30" aria-label="移除">×</button>
					</div>`;
				const image = card.querySelector('img');
				if (image instanceof HTMLImageElement) image.src = item.localPreview || item.src;
				const alt = card.querySelector('[data-media-alt]');
				const caption = card.querySelector('[data-media-caption]');
				const decorative = card.querySelector('[data-media-decorative]');
				const size = card.querySelector('[data-media-size]');
				if (alt instanceof HTMLInputElement) {
					alt.value = item.alt;
					alt.disabled = item.decorative;
					alt.addEventListener('input', () => {
						item.alt = alt.value;
					});
				}
				if (caption instanceof HTMLInputElement) {
					caption.value = item.caption;
					caption.addEventListener('input', () => {
						item.caption = caption.value;
					});
				}
				if (decorative instanceof HTMLInputElement) {
					decorative.checked = item.decorative;
					decorative.addEventListener('change', () => {
						item.decorative = decorative.checked;
						if (item.decorative) item.alt = '';
						renderMediaItems();
					});
				}
				if (size instanceof HTMLElement) {
					size.textContent = item.sourceFile
						? `${formatBytes(item.originalSize)} → ${formatBytes(item.uploadSize)} · ${item.note}`
						: '已上传资源';
				}
				card.querySelector('[data-media-up]')?.addEventListener('click', () => {
					if (index <= 0) return;
					[mediaItems[index - 1], mediaItems[index]] = [mediaItems[index], mediaItems[index - 1]];
					renderMediaItems();
				});
				card.querySelector('[data-media-down]')?.addEventListener('click', () => {
					if (index >= mediaItems.length - 1) return;
					[mediaItems[index + 1], mediaItems[index]] = [mediaItems[index], mediaItems[index + 1]];
					renderMediaItems();
				});
				card.querySelector('[data-media-remove]')?.addEventListener('click', () => {
					if (item.localPreview) URL.revokeObjectURL(item.localPreview);
					mediaItems.splice(index, 1);
					renderMediaItems();
				});
				mediaList.append(card);
			});
		};

		const addMediaFiles = async (files) => {
			const tools = mediaTools;
			if (!tools || mediaBusy) return;
			if (mediaItems.length + files.length > 12) {
				setMediaStatus('一个图片块最多支持 12 张图片。', true);
				return;
			}
			mediaBusy = true;
			const originalToggle = byId('editor-media-original');
			const useOriginal = originalToggle instanceof HTMLInputElement && originalToggle.checked;
			if (originalToggle instanceof HTMLInputElement) originalToggle.disabled = true;
			try {
				for (const sourceFile of files) {
					setMediaStatus(`正在处理 ${sourceFile.name}…`);
					const result = await tools.processEditorImage(sourceFile, useOriginal);
					mediaItems.push({
						src: '',
						alt: '',
						caption: '',
						decorative: false,
						sourceFile,
						uploadFile: result.file,
						localPreview: URL.createObjectURL(result.file),
						originalSize: result.originalSize,
						uploadSize: result.uploadSize,
						note: result.note,
						useOriginal
					});
					renderMediaItems();
				}
				setMediaStatus(`已准备 ${mediaItems.length} 张图片。`);
			} catch (error) {
				setMediaStatus(error instanceof Error ? error.message : '图片处理失败', true);
			} finally {
				mediaBusy = false;
				if (originalToggle instanceof HTMLInputElement) originalToggle.disabled = false;
			}
		};

		const reprocessMediaFiles = async () => {
			const tools = mediaTools;
			if (!tools || mediaBusy) return;
			const originalToggle = byId('editor-media-original');
			const useOriginal = originalToggle instanceof HTMLInputElement && originalToggle.checked;
			mediaBusy = true;
			if (originalToggle instanceof HTMLInputElement) originalToggle.disabled = true;
			try {
				const updates = [];
				for (const item of mediaItems) {
					if (!item.sourceFile || item.useOriginal === useOriginal) continue;
					setMediaStatus(`正在重新处理 ${item.sourceFile.name}…`);
					const result = await tools.processEditorImage(item.sourceFile, useOriginal);
					updates.push({ item, result });
				}
				for (const { item, result } of updates) {
					if (item.localPreview) URL.revokeObjectURL(item.localPreview);
					item.uploadFile = result.file;
					item.localPreview = URL.createObjectURL(result.file);
					item.uploadSize = result.uploadSize;
					item.note = result.note;
					item.useOriginal = useOriginal;
				}
				renderMediaItems();
				setMediaStatus(useOriginal ? '将上传原始文件。' : '已恢复智能压缩。');
			} catch (error) {
				const currentMode = mediaItems.find((item) => item.sourceFile)?.useOriginal ?? false;
				if (originalToggle instanceof HTMLInputElement) originalToggle.checked = currentMode;
				setMediaStatus(error instanceof Error ? error.message : '图片处理失败', true);
			} finally {
				mediaBusy = false;
				if (originalToggle instanceof HTMLInputElement) originalToggle.disabled = false;
			}
		};

		const resetMediaComposer = () => {
			releaseMediaPreviews();
			mediaItems = [];
			mediaReplaceRange = null;
			setMediaValue('editor-media-columns', 'auto');
			setMediaValue('editor-media-ratio', 'original');
			setMediaValue('editor-media-fit', 'contain');
			setMediaValue('editor-media-width', 'normal');
			setMediaValue('editor-media-caption', '');
			const original = byId('editor-media-original');
			if (original instanceof HTMLInputElement) original.checked = false;
			const urlInput = byId('editor-media-url');
			if (urlInput instanceof HTMLInputElement) urlInput.value = '';
			renderMediaItems();
			setMediaStatus('');
		};

		const openMediaComposer = () => {
			if (!(bodyInput instanceof HTMLTextAreaElement) || !(mediaDialog instanceof HTMLDialogElement)) return;
			resetMediaComposer();
			const tools = mediaTools;
			const match = tools?.findEditorMediaBlock(bodyInput.value, bodyInput.selectionStart, bodyInput.selectionEnd);
			if (match) {
				mediaReplaceRange = { start: match.start, end: match.end };
				mediaItems = match.block.images.map((image) => ({ ...image, decorative: !image.alt }));
				setMediaValue('editor-media-columns', match.block.columns);
				setMediaValue('editor-media-ratio', match.block.ratio);
				setMediaValue('editor-media-fit', match.block.fit);
				setMediaValue('editor-media-width', match.block.width);
				setMediaValue('editor-media-caption', match.block.caption);
				const title = byId('editor-media-title');
				if (title instanceof HTMLElement) title.textContent = '编辑图片块';
				if (mediaInsertButton instanceof HTMLButtonElement) mediaInsertButton.textContent = '更新图片块';
			} else {
				mediaReplaceRange = { start: bodyInput.selectionEnd, end: bodyInput.selectionEnd };
				const title = byId('editor-media-title');
				if (title instanceof HTMLElement) title.textContent = '插入图片';
				if (mediaInsertButton instanceof HTMLButtonElement) mediaInsertButton.textContent = '上传并插入';
			}
			renderMediaItems();
			mediaDialog.showModal();
		};

		const closeMediaComposer = () => {
			if (mediaBusy) return;
			if (mediaDialog instanceof HTMLDialogElement) mediaDialog.close();
			releaseMediaPreviews();
			mediaItems = [];
		};

		const uploadWithProgress = (url, headers, file, onProgress) =>
			new Promise((resolve, reject) => {
				const request = new XMLHttpRequest();
				request.open('PUT', url);
				Object.entries(headers).forEach(([name, value]) => request.setRequestHeader(name, value));
				request.upload.addEventListener('progress', (event) => {
					if (event.lengthComputable) onProgress(Math.round((event.loaded / event.total) * 100));
				});
				request.addEventListener('load', () => {
					if (request.status >= 200 && request.status < 300) resolve();
					else reject(new Error(`R2 返回 ${request.status}`));
				});
				request.addEventListener('error', () => reject(new Error('网络或 R2 CORS 阻止了上传。')));
				request.addEventListener('abort', () => reject(new Error('图片上传已取消。')));
				request.send(file);
			});

		const uploadMediaItem = async (item, index, total) => {
			if (!item.uploadFile) return item.src;
			setMediaStatus(`正在上传第 ${index + 1}/${total} 张图片…`);
			const preparedResponse = await fetch('/api/editor/media/prepare.json', {
				method: 'POST',
				headers: { 'content-type': 'application/json' },
				body: JSON.stringify({ filename: item.uploadFile.name, contentType: item.uploadFile.type, size: item.uploadFile.size })
			});
			const prepared = await preparedResponse.json();
			if (!preparedResponse.ok) throw new Error(prepared.error || '无法准备图片上传');
			await uploadWithProgress(prepared.uploadUrl, prepared.uploadHeaders, item.uploadFile, (progress) => {
				setMediaStatus(`正在上传第 ${index + 1}/${total} 张图片 · ${progress}%`);
			});
			return prepared.url;
		};

		const insertMediaBlock = async () => {
			if (mediaBusy || !(bodyInput instanceof HTMLTextAreaElement) || !mediaReplaceRange) return;
			if (mediaItems.length === 0) {
				setMediaStatus('请先添加至少一张图片。', true);
				return;
			}
			const missingAlt = mediaItems.find((item) => !item.decorative && !item.alt.trim());
			if (missingAlt) {
				setMediaStatus('请为每张非装饰图片填写 Alt 文本。', true);
				return;
			}
			const tools = mediaTools;
			if (!tools) return;
			mediaBusy = true;
			if (mediaInsertButton instanceof HTMLButtonElement) mediaInsertButton.disabled = true;
			const originalToggle = byId('editor-media-original');
			if (originalToggle instanceof HTMLInputElement) originalToggle.disabled = true;
			try {
				const images = [];
				for (let index = 0; index < mediaItems.length; index += 1) {
					const item = mediaItems[index];
					const src = await uploadMediaItem(item, index, mediaItems.length);
					item.src = src;
					item.uploadFile = null;
					images.push({
						src,
						alt: item.decorative ? '' : item.alt.trim(),
						caption: item.caption.trim()
					});
				}
				const block = {
					kind: images.length === 1 ? 'image' : 'gallery',
					images,
					columns: getMediaSelectValue('editor-media-columns', 'auto'),
					ratio: getMediaSelectValue('editor-media-ratio', 'original'),
					fit: getMediaSelectValue('editor-media-fit', 'contain'),
					width: getMediaSelectValue('editor-media-width', images.length === 1 ? 'normal' : 'wide'),
					caption: getInput('editor-media-caption')?.value.trim() || ''
				};
				const directive = tools.serializeEditorMediaBlock(block);
				const isReplacing = mediaReplaceRange.end > mediaReplaceRange.start;
				const inserted = isReplacing ? directive : `\n\n${directive}\n\n`;
				bodyInput.setRangeText(inserted, mediaReplaceRange.start, mediaReplaceRange.end, 'end');
				hasUnpublishedChanges = true;
				scheduleDraft();
				setStatus(`${isReplacing ? '已更新' : '已插入'}${images.length === 1 ? '图片' : `${images.length} 张图库`}，尚未发布`);
				mediaBusy = false;
				closeMediaComposer();
				bodyInput.focus();
			} catch (error) {
				setMediaStatus(error instanceof Error ? error.message : '图片上传失败', true);
			} finally {
				mediaBusy = false;
				if (mediaInsertButton instanceof HTMLButtonElement) mediaInsertButton.disabled = false;
				if (originalToggle instanceof HTMLInputElement) originalToggle.disabled = false;
			}
		};

		const publish = async () => {
			if (publishing || !publishPayload) return;
			publishing = true;
			if (confirmPublish instanceof HTMLButtonElement) confirmPublish.disabled = true;
			if (publishButton instanceof HTMLButtonElement) publishButton.disabled = true;
			setStatus('正在提交到 GitHub…');
			try {
				const response = await fetch('/api/editor/content/publish.json', {
					method: 'POST',
					headers: { 'content-type': 'application/json' },
					body: JSON.stringify(publishPayload)
				});
				const result = await response.json();
				if (!response.ok) throw new Error(result.error || '发布失败');
				activePath = result.path;
				activeSha = result.sha;
				hasUnpublishedChanges = false;
				localStorage.removeItem(storageKey);
				setSaveState('已发布');
				setStatus(`发布成功，部署完成后访问 ${result.publicPath}`);
				if (dialog instanceof HTMLDialogElement) dialog.close();
				await loadList();
			} catch (error) {
				setStatus(error instanceof Error ? error.message : '发布失败', 'error');
			} finally {
				publishing = false;
				if (confirmPublish instanceof HTMLButtonElement) confirmPublish.disabled = false;
				if (publishButton instanceof HTMLButtonElement) publishButton.disabled = app.dataset.canPublish !== 'true';
			}
		};

		form?.addEventListener('input', () => {
			hasUnpublishedChanges = true;
			scheduleDraft();
		});
		form?.addEventListener('submit', (event) => {
			event.preventDefault();
			if (!(form instanceof HTMLFormElement) || !form.reportValidity()) return;
			publishPayload = collect();
			const summary = byId('editor-publish-summary');
			if (summary instanceof HTMLElement) {
				const target = publishPayload.path || `src/content/${activeType === 'blog' ? 'blog' : 'fragments'}/${publishPayload.slug}/index.md`;
				summary.textContent = `${publishPayload.sha ? '更新' : '新建'} · ${activeType === 'blog' ? '长文' : '随笔'} · ${publishPayload.title} · ${target}`;
			}
			if (dialog instanceof HTMLDialogElement) dialog.showModal();
		});
		confirmPublish?.addEventListener('click', (event) => {
			event.preventDefault();
			publish();
		});
		byId('editor-new')?.addEventListener('click', () => {
			if (!hasUnpublishedChanges || window.confirm('当前编辑内容已经保存在本机草稿中。仍要新建并替换编辑区吗？')) newDocument(activeType);
		});
		byId('editor-refresh')?.addEventListener('click', loadList);
		existingSelect?.addEventListener('change', () => loadDocument(existingSelect.value));
		typeButtons.forEach((button) =>
			button.addEventListener('click', () => {
				const oldDefault = defaultSlug(activeType);
				const nextType = button.getAttribute('data-editor-type') === 'fragment' ? 'fragment' : 'blog';
				applyType(nextType);
				const slug = getInput('editor-slug');
				if (!activePath && slug && (!slug.value || slug.value === oldDefault)) slug.value = defaultSlug(nextType);
				scheduleDraft();
			})
		);

		document.querySelectorAll('[data-editor-tab]').forEach((button) =>
			button.addEventListener('click', () => {
				const previewing = button.getAttribute('data-editor-tab') === 'preview';
				document.querySelectorAll('[data-editor-tab]').forEach((node) => node.classList.toggle('is-active', node === button));
				byId('editor-write-panel')?.classList.toggle('hidden', previewing);
				byId('editor-preview-panel')?.classList.toggle('hidden', !previewing);
				if (previewing) renderPreview();
			})
		);

		document.querySelectorAll('[data-editor-wrap]').forEach((button) =>
			button.addEventListener('click', () => {
				if (!(bodyInput instanceof HTMLTextAreaElement)) return;
				const marker = button.getAttribute('data-editor-wrap') || '';
				const start = bodyInput.selectionStart;
				const end = bodyInput.selectionEnd;
				bodyInput.setRangeText(`${marker}${bodyInput.value.slice(start, end)}${marker}`, start, end, 'select');
				bodyInput.focus();
				scheduleDraft();
			})
		);
		document.querySelectorAll('[data-editor-prefix]').forEach((button) =>
			button.addEventListener('click', () => {
				if (!(bodyInput instanceof HTMLTextAreaElement)) return;
				const prefix = button.getAttribute('data-editor-prefix') || '';
				const lineStart = bodyInput.value.lastIndexOf('\n', bodyInput.selectionStart - 1) + 1;
				bodyInput.setRangeText(prefix, lineStart, lineStart, 'end');
				bodyInput.focus();
				scheduleDraft();
			})
		);

		byId('editor-media-open')?.addEventListener('click', openMediaComposer);
		byId('editor-media-close')?.addEventListener('click', closeMediaComposer);
		byId('editor-media-cancel')?.addEventListener('click', closeMediaComposer);
		mediaDialog?.addEventListener('cancel', (event) => {
			if (mediaBusy) event.preventDefault();
			else closeMediaComposer();
		});
		mediaInsertButton?.addEventListener('click', insertMediaBlock);
		const mediaDropzone = byId('editor-media-dropzone');
		mediaDropzone?.addEventListener('click', () => {
			if (mediaFileInput instanceof HTMLInputElement) mediaFileInput.click();
		});
		mediaDropzone?.addEventListener('keydown', (event) => {
			if (event.key !== 'Enter' && event.key !== ' ') return;
			event.preventDefault();
			if (mediaFileInput instanceof HTMLInputElement) mediaFileInput.click();
		});
		mediaDropzone?.addEventListener('dragover', (event) => {
			event.preventDefault();
			mediaDropzone.classList.add('border-zinc-600');
		});
		mediaDropzone?.addEventListener('dragleave', () => mediaDropzone.classList.remove('border-zinc-600'));
		mediaDropzone?.addEventListener('drop', (event) => {
			event.preventDefault();
			mediaDropzone.classList.remove('border-zinc-600');
			if (event.dataTransfer?.files.length) addMediaFiles([...event.dataTransfer.files]);
		});
		mediaFileInput?.addEventListener('change', () => {
			if (mediaFileInput instanceof HTMLInputElement && mediaFileInput.files?.length) {
				addMediaFiles([...mediaFileInput.files]);
				mediaFileInput.value = '';
			}
		});
		byId('editor-media-original')?.addEventListener('change', reprocessMediaFiles);
		byId('editor-media-ratio')?.addEventListener('change', () => {
			setMediaValue('editor-media-fit', getMediaSelectValue('editor-media-ratio', 'original') === 'original' ? 'contain' : 'cover');
		});
		byId('editor-media-add-url')?.addEventListener('click', () => {
			const input = byId('editor-media-url');
			if (!(input instanceof HTMLInputElement)) return;
			try {
				if (mediaItems.length >= 12) throw new Error('limit');
				const url = new URL(input.value.trim());
				if (!['http:', 'https:'].includes(url.protocol)) throw new Error();
				mediaItems.push({ src: url.toString(), alt: '', caption: '', decorative: false });
				input.value = '';
				renderMediaItems();
				setMediaStatus('已添加图片 URL。');
			} catch (error) {
				setMediaStatus(
					error instanceof Error && error.message === 'limit' ? '一个图片块最多支持 12 张图片。' : '请输入有效的 http(s) 图片 URL。',
					true
				);
			}
		});

		byId('editor-logout')?.addEventListener('click', async () => {
			await fetch('/api/editor/logout.json', { method: 'POST' });
			window.location.reload();
		});
		if ('serviceWorker' in navigator) navigator.serviceWorker.register('/editor-sw.js', { scope: '/editor/' }).catch(() => {});
		window.addEventListener('pagehide', saveDraft);
		restoreDraft();
		loadList();
	};

	if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', setupEditorPage, { once: true });
	else setupEditorPage();
	document.addEventListener('astro:page-load', setupEditorPage);
</script>
